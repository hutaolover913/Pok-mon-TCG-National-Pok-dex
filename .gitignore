# ============================================================
#  寶可夢 PTCG 全圖鑑收藏 — .gitignore
#
#  原則：只把「原始碼 + App 執行必要的資料檔」放進版本控制。
#  下載下來的卡圖、第三方補圖包、流程執行過程中的暫存與紀錄，
#  都可以靠 data/pipeline/ 裡的腳本重新產生，不進 git。
# ============================================================

# ------------------------------------------------------------
# 本機下載的圖片（約 957 MB / 16,900 個檔案）
#
# 一定要排除：GitHub 單一 repo 建議控制在 1 GB 以內，這個資料夾
# 幾乎就把額度用光，push 會非常慢甚至失敗。而且這些是寶可夢卡片
# 的官方卡圖，屬於 The Pokémon Company 等權利人的著作，不適合
# 重新散布到公開 repo。
#
# 重新取得方式（見 README「圖片：本機快取」一節）：
#   python data/pipeline/step5_download_images.py
#   python data/pipeline/step6_build_image_map.py
#
# ------------------------------------------------------------
images/

# ------------------------------------------------------------
# 本機圖片對照表
#
# 這個檔案描述的是「這台機器上有哪些圖片檔」，由 step6 依照實際下載成果
# 重建，本質上是本機快取的索引，不是專案原始碼。
#
# 而且它一定要跟著 images/ 一起排除：如果 clone 下來沒有 images/ 卻有這份
# 對照表，前端會把每張卡都指向一個不存在的本機路徑，結果是整個 App 都顯示
# 佔位圖 —— 連那 11,782 張本來可以直接用 TCGdex 遠端網址顯示的卡片也一樣。
# 沒有這個檔案時，App 會自動全部退回遠端網址，clone 下來就能直接看。
# ------------------------------------------------------------
data/image_local_map.json

# 啟動器每次開機寫入的識別檔（含這台機器上的專案絕對路徑），機器專屬、不進 git
data/app_id.txt

# ------------------------------------------------------------
# 第三方補圖包（約 108 MB，來源 tcgcollector.com）
# 這是使用者自行提供的素材，不是本專案產出，也不該再散布出去。
# ------------------------------------------------------------
exports/

# ------------------------------------------------------------
# 資料管線的暫存與執行紀錄
#
# index/  ：TCGdex 卡表索引快取，重跑 step1/step2 會重新產生
# logs/   ：每次執行的進度與結果紀錄，其中 image_manifest.json
#           一個檔案就 6.6 MB，而且每跑一次就整份改寫，放進 git
#           只會讓歷史暴增。
#
# 但底下幾份「結論型」報告很小、又能說明資料從哪來，用 ! 留下來。
# ------------------------------------------------------------
data/pipeline/index/
data/pipeline/logs/*
!data/pipeline/logs/.gitkeep
!data/pipeline/logs/candidate_decisions.json
!data/pipeline/logs/final_still_missing.json
!data/pipeline/logs/image_audit_report.json
!data/pipeline/logs/image_final_report.json
!data/pipeline/logs/rarity_to_category_mapping.json

# 抓來研究來源網站結構用的暫存網頁／腳本，沒有保存價值
data/pipeline/logs/research_*.html
data/pipeline/logs/research_*.js

# ------------------------------------------------------------
# 產生出來的報告檔（跑 step15_build_word_report.py 就會重新產生）
# 想把成品一起放上 GitHub 的話，把下面兩行刪掉即可。
# ------------------------------------------------------------
*.docx
~$*.docx

# ------------------------------------------------------------
# 使用者的個人收藏備份
#
# 這很重要：匯出的備份檔含有你的收藏紀錄，而且從 formatVersion 2
# 起還會把手動上傳的圖片以 base64 一起包進去，檔案可能很大，
# 內容也屬於個人資料，絕對不要不小心 commit 上公開 repo。
# ------------------------------------------------------------
*收藏備份*.json
*覆蓋前備份*.json
*清除前備份*.json

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ------------------------------------------------------------
# 編輯器 / IDE
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code 的本機個人設定（launch.json 是共用的，保留）
.claude/settings.local.json

# ------------------------------------------------------------
# 作業系統產生的垃圾檔
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ------------------------------------------------------------
# 暫存檔
# ------------------------------------------------------------
*.log
*.tmp
*.bak
tmp/
temp/

# ------------------------------------------------------------
# 使用者自己匯出的 Excel 卡表與清單
#
# ptcg卡表/        ：從 App 的「匯出卡表」功能產生的成品，隨時可以重新匯出。
# PTCG_缺少卡片清單.xlsx ：這次補卡流程的來源清單（3.2 MB），屬於一次性的工作檔。
#
# 兩者都不是 App 執行必要的檔案，排除後 clone 下來一樣能正常使用。
# 想把它們一起放進版本控制的話，把下面兩行刪掉即可。
# ------------------------------------------------------------
ptcg卡表/
PTCG_缺少卡片清單.xlsx

# ============================================================
#  android-app/.gitignore
# ============================================================

# build_www.py 每次都從共用原始碼重新組裝，沒有保存價值
www/

# build_thumbs.py 產生的內建卡圖（約 65 MB / 4,064 張）。
# 這些是從 images/ 縮出來的，images/ 本身也沒進 git（見根目錄 .gitignore），
# 要重建就跑 python android-app/build_thumbs.py
thumbs/
app_image_map.json

node_modules/

# ------------------------------------------------------------
# Capacitor 產生的 Android 專案的建置產物
# ------------------------------------------------------------
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/.idea/
# npx cap sync 會把整個 www/ 複製到這裡，是重複的
android/app/src/main/assets/public/

# ------------------------------------------------------------
# 簽章金鑰：絕對不能進版本控制
#
# 金鑰請產在 repo 外面（例如 D:\keys\），並且另外備份 ——
# 弄丟就再也沒辦法更新同一個 App 了。
# ------------------------------------------------------------
*.keystore
*.jks
keystore.properties
android/app/release/
.env

# ------------------------------------------------------------
# 你從電腦版匯出的備份，build_www.py 用它取出手動分類。
#
# 這是完整備份，裡面有你的收藏紀錄，屬於個人資料，絕對不要 commit。
# build_www.py 只會讀 categoryOverrides 與 fieldOverrides 兩項，
# 收藏張數、點亮紀錄、自訂圖片都不會進 APK。
# ------------------------------------------------------------
curation-source.json
